{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://coordinacion-gemb.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?ruta=as-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/(.*)",
      "destination": "/api/oauth?ruta=as-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?ruta=pr-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/(.*)",
      "destination": "/api/oauth?ruta=pr-metadata"
    },
    {
      "source": "/api/oauth/register",
      "destination": "/api/oauth?ruta=register"
    },
    {
      "source": "/api/oauth/authorize",
      "destination": "/api/oauth?ruta=authorize"
    },
    {
      "source": "/api/oauth/token",
      "destination": "/api/oauth?ruta=token"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
