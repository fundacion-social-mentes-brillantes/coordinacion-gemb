{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/avisos",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-write=(self), web-share=(self), fullscreen=(self)"
        }
      ]
    },
    {
      "source": "/((?!__/|api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-FOxQA/slgBQSHZqKx8YWAzh2uIskNjlRq5NaBFDnQPY=' https://apis.google.com https://www.gstatic.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com https://www.gstatic.com; font-src 'self' data:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://apis.google.com https://firebaseinstallations.googleapis.com; frame-src 'self' https://coordinacion-gemb.firebaseapp.com https://accounts.google.com https://apis.google.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://coordinacion-gemb.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://coordinacion-gemb.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?ruta=as-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/(.*)",
      "destination": "/api/oauth?ruta=as-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?ruta=pr-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/(.*)",
      "destination": "/api/oauth?ruta=pr-metadata"
    },
    {
      "source": "/api/oauth/register",
      "destination": "/api/oauth?ruta=register"
    },
    {
      "source": "/api/oauth/authorize",
      "destination": "/api/oauth?ruta=authorize"
    },
    {
      "source": "/api/oauth/token",
      "destination": "/api/oauth?ruta=token"
    },
    {
      "source": "/api/oauth/aprobar",
      "destination": "/api/oauth?ruta=aprobar"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
