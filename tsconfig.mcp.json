{
  // ---------------------------------------------------------------------
  //  Comprobación de tipos del servidor MCP: lo que de verdad se despliega.
  //
  //  Hacía falta porque el tsconfig.json principal solo mira "src", y
  //  `npm run build:api` usa esbuild, que EMPAQUETA pero no comprueba tipos.
  //  Resultado: mcp/src/ se subía a producción sin que nadie mirara los
  //  tipos ni una vez. Este archivo cierra ese hueco y `npm run build` lo
  //  ejecuta.
  //
  //  Entran los dos puntos de entrada que Vercel despliega y todo lo que
  //  arrastran. Queda fuera mcp/src/index.ts (el servidor de terminal), que
  //  necesita el SDK de MCP instalado aparte, en mcp/node_modules.
  // ---------------------------------------------------------------------
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": ["mcp/src/http.ts", "mcp/src/oauth-http.ts"]
}
