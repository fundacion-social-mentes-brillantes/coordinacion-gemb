rules_version = '2';

// =====================================================================
//  Reglas de seguridad de Firestore — Asistencia GEMB
// ---------------------------------------------------------------------
//  Publícalas en: consola de Firebase → Firestore → pestaña "Reglas"
//  → pega TODO este archivo → "Publicar".
//  Sin esto la app no puede leer ni escribir (el proyecto está en modo
//  producción).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------- Helpers --------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Cuenta de Google con el correo verificado. Hoy Google es el único método
    // de ingreso habilitado, pero dar roles no debe depender de esa
    // configuración: con correo/contraseña cualquiera podría registrarse con
    // el correo de una persona invitada (o con el del super admin).
    function isGoogle() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Correo del super administrador (admin de admins). Debe coincidir con
    // SUPER_ADMIN_EMAIL en src/lib/firebase.ts.
    function superEmail() {
      return 'fundacionsocial@gimnasioemocionalmb.com';
    }
    function isSuperEmail(email) {
      return email.lower() == superEmail();
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Rol del usuario actual ('none' si aún no tiene documento).
    function role() {
      return userExists() ? userData().role : 'none';
    }
    function isActive() {
      return userExists() && userData().active == true;
    }

    function isSuper() {
      return role() == 'super_admin';
    }
    function isAdmin() {
      return role() == 'admin' || role() == 'super_admin';
    }
    // "Staff" = quien puede marcar asistencia y crear sesiones.
    function isStaff() {
      return role() == 'coordinador' || isAdmin();
    }
    // Cualquiera con un rol real y la cuenta activa (no pendiente).
    function canRead() {
      return isSignedIn() && role() != 'pending' && role() != 'none' && isActive();
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }
    function sessionIsOpen(sessionId) {
      return sessionData(sessionId).status == 'open';
    }
    // ¿Es el momento de tomar lista en esta sesión? La fecha se guarda al
    // mediodía de Bogotá (17:00 UTC), así que se puede marcar desde la
    // medianoche de Bogotá del día de la reunión (12 h antes) hasta 3 días
    // después. Así una sesión agendada para otro día no recibe por error la
    // lista de hoy, y una que alguien olvidó finalizar no se sigue llenando
    // semanas después. La administración no tiene esta restricción.
    function sessionInWindow(sessionId) {
      let d = sessionData(sessionId).date;
      return d <= request.time + duration.value(12, 'h')
        && d >= request.time - duration.value(3, 'd');
    }

    // Las invitaciones se guardan con el correo en minúsculas como id.
    function hasInvite(r) {
      return exists(/databases/$(database)/documents/invites/$(myEmail())) &&
        get(/databases/$(database)/documents/invites/$(myEmail())).data.role == r;
    }

    // -------------------- users --------------------
    match /users/{userId} {
      // Cada quien lee su propio documento; la administración activa lee
      // todos (una administradora a la que se le quitó el acceso, no).
      allow read: if isSignedIn()
        && (request.auth.uid == userId || (isAdmin() && isActive()));

      // Alta del propio documento en el primer ingreso.
      // El correo guardado DEBE ser el del propio usuario autenticado: así
      // nadie puede crear su documento con el correo de otra persona (ni el
      // del super admin) para suplantar identidad o bloquear la administración.
      allow create: if isGoogle()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          // El super admin se crea a sí mismo como super_admin.
          (isSuperEmail(request.auth.token.email)
            && request.resource.data.role == 'super_admin'
            && request.resource.data.active == true)
          ||
          // Cualquiera se crea como pendiente.
          (request.resource.data.role == 'pending')
          ||
          // Con una invitación previa se crea con el rol invitado.
          (request.resource.data.role in ['admin', 'coordinador']
            && hasInvite(request.resource.data.role))
        );

      // Actualización.
      allow update: if isSignedIn() && (
        // A) El super admin corrige/mantiene su propio documento.
        (request.auth.uid == userId
          && isGoogle()
          && isSuperEmail(request.auth.token.email)
          && request.resource.data.role == 'super_admin'
          && request.resource.data.active == true)
        ||
        // B) Administración de otros usuarios.
        (isAdmin() && isActive()
          && !isSuperEmail(resource.data.email) // nunca el doc del super admin
          && (
            // El super gestiona a cualquiera (incluidos admins).
            isSuper()
            ||
            // El admin normal solo gestiona coordinadores/pendientes y NO
            // puede crear/editar administradores.
            (resource.data.role in ['coordinador', 'pending']
              && request.resource.data.role in ['coordinador', 'pending'])
          ))
      );

      // Nadie puede borrar el documento del super admin.
      allow delete: if isSuper() && isActive() && !isSuperEmail(resource.data.email);
    }

    // -------------------- invites (pre-autorizaciones) --------------------
    // ID del documento = correo en minúsculas.
    match /invites/{inviteId} {
      // Al ingresar, cada quien consulta SOLO su propia invitación. La lista
      // completa (correos y roles de todas) es solo para la administración.
      allow get: if isSignedIn() && inviteId == myEmail();
      allow list: if isAdmin() && isActive();

      // El super invita coordinadores y admins; el admin solo coordinadores.
      allow create, update: if isActive() && (
        (isSuper() && request.resource.data.role in ['admin', 'coordinador'])
        || (isAdmin() && request.resource.data.role == 'coordinador')
      );
      // La administración las borra; la propia invitada, una vez usada (ya
      // tiene su documento): así no vuelve a dar el rol si la cuenta se recrea.
      allow delete: if (isAdmin() && isActive())
        || (isSignedIn() && inviteId == myEmail()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // -------------------- members (personas) --------------------
    match /members/{memberId} {
      allow read: if canRead();
      // Crear: coordinador (walk-in) y admin (alta/importación).
      // Crear: la administradora sin restricciones (alta manual/importación).
      // La coordinadora SOLO puede crear personas marcadas "por revisar":
      // así nadie entra a la lista oficial sin que la coordinación lo apruebe.
      allow create: if isActive() && (
        isAdmin()
        || (isStaff() && request.resource.data.get('pendingReview', false) == true)
      );

      // Editar: admin sin restricciones. Excepción: las fichas provisionales
      // "Por identificar" también las puede corregir una coordinadora (para
      // ponerles el nombre real), pero NO puede aprobarlas: la marca
      // "por revisar" tiene que quedar como estaba.
      // Puede corregir cualquier ficha que AÚN no esté aprobada (sin nombre
      // o por revisar), pero NO puede quitarle la marca "por revisar": eso
      // le toca a la administradora. En cuanto se aprueba, queda blindada.
      allow update: if isActive() && (
        isAdmin()
        || (isStaff()
          && (resource.data.get('pendingIdentify', false) == true
              || resource.data.get('pendingReview', false) == true)
          && request.resource.data.get('pendingReview', false)
             == resource.data.get('pendingReview', false))
      );

      // Borrar: admin; y la coordinadora solo fichas sin aprobar (al
      // fusionarlas con una persona que ya existía).
      allow delete: if isActive() && (
        isAdmin()
        || (isStaff()
          && (resource.data.get('pendingIdentify', false) == true
              || resource.data.get('pendingReview', false) == true))
      );
    }

    // -------------------- sessions (reuniones) --------------------
    match /sessions/{sessionId} {
      allow read: if canRead();
      // Crear sesiones: coordinador y admin. Toda sesión nace abierta y en 0.
      allow create: if isStaff() && isActive()
        && request.resource.data.status == 'open'
        && request.resource.data.presentCount == 0
        && request.resource.data.type in ['entrega_pasos', 'reduccion_ego']
        && request.resource.data.modality in ['presencial', 'virtual']
        && request.resource.data.date is timestamp;
      // Actualizar. Nadie reescribe quién ni cuándo la creó: así crear dos
      // veces la misma sesión (dos celulares, mismo id) no pisa la primera.
      allow update: if isActive()
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['createdAt', 'createdBy'])
        && (
        // El admin puede todo (incluido reabrir y editar).
        isAdmin()
        ||
        (role() == 'coordinador' && (
          // A) Mientras trabaja Y SOLO si la sesión sigue ABIERTA: ajustar el
          //    contador de presentes (auto-mantenido al marcar/desmarcar) y
          //    asignar quién coordina. No puede cambiar el estado ni ningún
          //    otro campo. Sin la condición de "abierta", una sesión ya
          //    finalizada seguiría siendo editable por esta rama.
          (resource.data.status == 'open'
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['presentCount', 'coordinator']))
          ||
          // B) FINALIZAR la sesión: solo de abierta a cerrada y sin tocar
          //    nada más. Reabrir queda reservado a la administradora.
          (resource.data.status == 'open'
            && request.resource.data.status == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status']))
        ))
      );
      // Borrar sesión: solo admin.
      allow delete: if isAdmin() && isActive();

      // -------------------- attendance (asistencia) --------------------
      match /attendance/{memberId} {
        allow read: if canRead();

        // La coordinadora marca y quita solo con la sesión ABIERTA y en su
        // día (ver sessionInWindow). La administración también corrige
        // sesiones cerradas (p. ej. poner el nombre real días después).
        function staffCanMark() {
          return isStaff() && sessionIsOpen(sessionId) && sessionInWindow(sessionId);
        }

        // Marcar = crear. El id es el de la persona.
        allow create: if isActive()
          && request.resource.data.memberId == memberId
          && request.resource.data.sessionId == sessionId
          && request.resource.data.status == 'present'
          && (isAdmin() || staffCanMark());

        // Una asistencia ya registrada solo admite corregir el nombre. Volver
        // a "marcar" a quien ya estaba (dos celulares a la vez, o uno que
        // estaba sin señal) reescribiría su hora de llegada y sumaría dos
        // veces al contador: se rechaza, y con ella todo su lote.
        allow update: if isActive()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName'])
          && (isAdmin() || (isStaff() && sessionIsOpen(sessionId)));

        // Quitar = borrar. Solo lo que existe: sin esa condición, quitar dos
        // veces a la misma persona restaría dos al contador.
        allow delete: if isActive()
          && resource != null
          && (isAdmin() || staffCanMark());
      }
    }

    // Lectura de TODA la asistencia en conjunto (consulta de grupo de
    // colección): la usan el Panel y las correcciones de nombre.
    match /{path=**}/attendance/{memberId} {
      allow read: if canRead();
    }
  }
}
