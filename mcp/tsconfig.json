{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Solo los modulos de la app que el servidor reutiliza. El resto de
  // src/lib es codigo de navegador (DOM) y no compila fuera de el.
  "include": [
    "src/**/*.ts",
    "../api/**/*.ts",
    "../src/lib/activity.ts",
    "../src/lib/dates.ts",
    "../src/lib/normalize.ts",
    "../src/lib/constants.ts",
    "../src/lib/oauthRedirect.ts",
    "../src/types/index.ts"
  ]
}
